# Sahakar 360 Admin — environment. Copy this file to `.env.local` (git-ignored via
# `*.local`) and fill in the real values. Vite only exposes vars prefixed
# `VITE_`.

# --- Neon Postgres -----------------------------------------------------------
# The same database the Flutter app uses (`app` schema). Copy the pooled
# connection string from the Neon console → your project → "Connection string".
# NOTE: this value is bundled into the shipped JS. Only run this console for
# internal staff, behind login.
VITE_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# --- Backend API (backend/api/, see backend/docs/) --------------------------
# Staff auth (login/logout/session) goes through this service now instead of
# the static credential list — email + password, checked server-side against
# a bcrypt hash, no Firebase involved for staff. Point at a locally-running
# instance for dev (`pnpm dev` in backend/api/) or the deployed URL once one
# exists.
VITE_API_BASE_URL=http://localhost:3000

# Firebase is no longer used by this console (staff login moved to
# email+password against the backend — see AuthContext.tsx). Member phone
# auth in the root Flutter app is separate and unaffected.
