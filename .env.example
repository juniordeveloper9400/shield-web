# Sahakar 360 Admin — environment. Copy this file to `.env.local` (git-ignored via
# `*.local`) and fill in the real values. Vite only exposes vars prefixed
# `VITE_`.

# --- Neon Postgres -----------------------------------------------------------
# The same database the Flutter app uses (`app` schema). Copy the pooled
# connection string from the Neon console → your project → "Connection string".
# NOTE: this value is bundled into the shipped JS. Only run this console for
# internal staff, behind login.
VITE_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# --- Backend API (backend/api/, see backend/docs/) --------------------------
# Staff auth (login/logout/session) goes through this service now instead of
# the static credential list — email + password, checked server-side against
# a bcrypt hash, no Firebase involved for staff. Point at a locally-running
# instance for dev (`pnpm dev` in backend/api/) or the deployed URL once one
# exists.
VITE_API_BASE_URL=http://localhost:3000

# Firebase is no longer used by this console (staff login moved to
# email+password against the backend — see AuthContext.tsx). Member phone
# auth in the root Flutter app is separate and unaffected.

# --- MSG91 Widget OTP (lib/msg91Otp.ts) --------------------------------------
# Verifies a member's phone at the counter before a bill is collected off
# their wallet (BillEditorModal, LabBookingModal) — replaces what used to be
# a separate Firebase project for the same check. Both values come from the
# MSG91 dashboard → OTP → Widget: `widgetId` from "Client Side Integration",
# `tokenAuth` from Authentication → Tokens (create a scoped Auth Token, NOT
# the master Auth Key — that one stays server-side only, see
# backend/api/.env.example MSG91_AUTH_KEY). Both are meant to travel in
# client-side code: `tokenAuth` is throttled/scoped specifically so it's
# safe to ship in the bundle.
VITE_MSG91_WIDGET_ID=
VITE_MSG91_TOKEN_AUTH=

# --- Sentry (crash and error reporting, main.tsx) ----------------------------
# Leave blank and it simply stays disabled, same as the two vars above being
# unset leaves their own features off. From a Sentry project → Settings →
# Client Keys (DSN); create a React project first if there isn't one yet.
# Public, not a secret — a DSN is meant to travel in client-side code. See
# docs/sentry.md.
VITE_SENTRY_DSN=
