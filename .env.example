# SHIELD Admin — environment. Copy this file to `.env.local` (git-ignored via
# `*.local`) and fill in the real values. Vite only exposes vars prefixed
# `VITE_`.

# --- Neon Postgres -----------------------------------------------------------
# The same database the Flutter app uses (`app` schema). Copy the pooled
# connection string from the Neon console → your project → "Connection string".
# NOTE: this value is bundled into the shipped JS. Only run this console for
# internal staff, behind the Firebase login.
VITE_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# --- Firebase Auth (Email/Password) ----------------------------------------
# Firebase console → Project settings → General → "Your apps" → Web app →
# "SDK setup and configuration". Enable Authentication → Sign-in method →
# Email/Password. These values are not secret (they ship in every web client);
# the real ones for project shield-zabnix are filled in below.
VITE_FIREBASE_API_KEY=AIzaSyAjXbkhrPPgq9hwlhdKB21dG2VfvatAXTI
VITE_FIREBASE_AUTH_DOMAIN=shield-zabnix.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=shield-zabnix
VITE_FIREBASE_APP_ID=1:1086152719549:web:199b8c17ac57081cda0bd4
# Optional:
VITE_FIREBASE_STORAGE_BUCKET=shield-zabnix.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1086152719549
